{
	"name": "parleralajustice",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.4.0",
	"scripts": {
		"deploy": "vite build && wrangler deploy",
		"dev": "vite",
		"start": "vite",
		"build": "vite build",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"cf:login": "wrangler login",
		"cf:whoami": "wrangler whoami",
		"db:migrate": "wrangler d1 execute parleralajustice --file=migrations/0001_better_auth.sql && wrangler d1 execute parleralajustice --file=migrations/0002_cases.sql",
		"db:migrate:local": "wrangler d1 execute parleralajustice --local --file=migrations/0001_better_auth.sql && wrangler d1 execute parleralajustice --local --file=migrations/0002_cases.sql"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.4",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@stylexjs/unplugin": "0.19.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.5.2",
		"unplugin": "2.3.11",
		"vite": "^8.2.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@heroui/react": "^3.2.4",
		"@stylexjs/stylex": "0.19.0",
		"better-auth": "^1.7.3",
		"framer-motion": "^13.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}