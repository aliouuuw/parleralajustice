{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "parleralajustice",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"ratelimits": [
		{
			"name": "CASE_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "parleralajustice",
			"database_id": "a59935fc-6b93-49c7-b5e0-c54606639698"
		}
	],
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "parleralajustice-audio"
		}
	]
}